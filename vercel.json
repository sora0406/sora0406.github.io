{
  "version": 2,
  "buildCommand": "./vercel-build.sh",
  "installCommand": "npm install --legacy-peer-deps",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/fonts/*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    { "source": "/", "destination": "/dashboard/supply-chain", "permanent": true }
  ],
  "framework": "nextjs",
  "outputDirectory": ".next"
} 