{
  "version": 2,
  "buildCommand": "./vercel-build.sh",
  "installCommand": "pnpm install --frozen-lockfile=false",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    { "source": "/", "destination": "/dashboard/survey-results", "permanent": true }
  ],
  "framework": "nextjs",
  "outputDirectory": ".next",
  "env": {
    "NODEJS_VERSION": "18.20.3",
    "NPM_FLAGS": "--legacy-peer-deps"
  }
} 